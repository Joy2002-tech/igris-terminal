{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/refresh-screener.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/refresh-screener",
      "schedule": "0 11 * * 1-5"
    }
  ]
}
